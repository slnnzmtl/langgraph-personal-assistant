[
  {
    "jobName": "sync-finance",
    "schedule": "1 0 * * *",
    "targetRoute": "Finance_SG",
    "payload": {
      "action": "sync_finance",
      "when": "yesterday",
      "steps": ["fetch_wise_transactions", "exec_sql"],
      "targetTable": "public.expenses"
    }
  },
  {
    "jobName": "routine-note-creation",
    "schedule": "0 7 * * *",
    "targetRoute": "Obsidian_SG",
    "payload": {
      "action": "create_daily_routine_note",
      "template": "## Summary\n- [ ] Task 1\n- [ ] Task 2\n\n## Events\n- Event 1: Description\n\n## Notes\n- Note 1: Description",
      "moveUnresolvedFrom": "yesterday",
      "saveLocation": "vault/daily-routines"
    }
  }
]
