{
  "name": "personal-assistant-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "dev": "pnpm --filter personal-assistant dev",
    "dev:scheduler": "pnpm --filter personal-assistant dev:scheduler",
    "start": "pnpm --filter personal-assistant start",
    "start:scheduler": "pnpm --filter personal-assistant start:scheduler",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:e2e": "pnpm --filter personal-assistant test:e2e",
    "test:e2e:ui": "pnpm --filter personal-assistant test:e2e:ui"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "@langchain/core": "1.2.1"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "packageManager": "pnpm@10.13.1"
}
